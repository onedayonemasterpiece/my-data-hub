# Private environment for the isolated my-data-hub showcase runtime.
# Copy outside the repository, chmod 0600, and fill adapter secrets.
# Never pass this file to remote-mcp.

MY_DATA_HUB_ARTIFACT_ROOT=/var/lib/my-data-hub-showcase
MY_DATA_HUB_SHOWCASE_BUILD_TIMEOUT_SECONDS=
MY_DATA_HUB_SHOWCASE_GITHUB_REF=main
MY_DATA_HUB_SHOWCASE_GITHUB_REPOSITORY=onedayonemasterpiece/idea-hub
MY_DATA_HUB_SHOWCASE_GITHUB_ROOT=showcase
MY_DATA_HUB_SHOWCASE_GITHUB_TOKEN=
# Optional bounded GitHub Git-Data write credential for showcase.apply; leave unset to fail closed.
MY_DATA_HUB_SHOWCASE_GITHUB_WRITE_TOKEN=
# Optional dedicated repo-scoped SSH deploy key; token takes precedence when explicitly set.
MY_DATA_HUB_SHOWCASE_GITHUB_WRITE_SSH_KEY_FILE=
MY_DATA_HUB_SHOWCASE_GITHUB_SSH_KEY_FILE=
MY_DATA_HUB_SHOWCASE_GITHUB_KNOWN_HOSTS_FILE=/run/config/github-known-hosts
MY_DATA_HUB_SHOWCASE_LOCAL_PUBLISH_ROOT=
MY_DATA_HUB_SHOWCASE_MAX_REQUEST_BYTES=262144
MY_DATA_HUB_SHOWCASE_NPM_COMMAND=
MY_DATA_HUB_SHOWCASE_OPERATION_JOURNAL=/var/lib/my-data-hub-showcase/showcase-operations.json
MY_DATA_HUB_SHOWCASE_ORIGIN=https://ideas.kenigevents.ru
MY_DATA_HUB_SHOWCASE_PUBLISH_COMMAND_JSON=
MY_DATA_HUB_SHOWCASE_REVOKE_COMMAND_JSON=
MY_DATA_HUB_SHOWCASE_RUNTIME_HOST=127.0.0.1
MY_DATA_HUB_SHOWCASE_RUNTIME_PORT=8790
MY_DATA_HUB_SHOWCASE_RUNTIME_TOKEN_FILE=
MY_DATA_HUB_SHOWCASE_SITE_DIR=/work/showcase-site
MY_DATA_HUB_SHOWCASE_SITE_ROOT=
MY_DATA_HUB_SHOWCASE_SITE_TEMPLATE_DIR=/opt/showcase-site
MY_DATA_HUB_SHOWCASE_SOURCE_ROOT=
MY_DATA_HUB_SHOWCASE_STATE_PATH=
