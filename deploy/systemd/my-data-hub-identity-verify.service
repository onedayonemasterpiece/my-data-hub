[Unit]
Description=my-data-hub restricted PostgreSQL runtime identity verification
After=my-data-hub-role-provision.service

[Service]
Type=oneshot
User=mydatahub
Group=mydatahub
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/my-data-hub.env
ExecStart=/opt/my-data-hub/venv/bin/python scripts/verify_service_identities.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
