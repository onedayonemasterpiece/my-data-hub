[Unit]
Description=my-data-hub PostgreSQL adversarial role and ownership probes
After=my-data-hub-role-provision.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/admin.env
ExecStart=/opt/my-data-hub/venv/bin/python scripts/verify_postgres_roles.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
