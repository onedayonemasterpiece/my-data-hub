[Unit]
Description=my-data-hub restricted database verification
After=postgresql.service

[Service]
Type=oneshot
User=mydatahub
Group=mydatahub
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/my-data-hub.env
ExecStart=/opt/my-data-hub/venv/bin/my-data-hub db verify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
