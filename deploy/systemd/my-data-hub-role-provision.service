[Unit]
Description=my-data-hub PostgreSQL least-privilege grants
After=my-data-hub-migrate.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/admin.env
ExecStart=/opt/my-data-hub/venv/bin/python scripts/provision_postgres_roles.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
