[Unit]
Description=my-data-hub password-free PostgreSQL role bootstrap
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/admin.env
ExecStart=/opt/my-data-hub/venv/bin/python scripts/provision_postgres_roles.py --bootstrap-only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
