[Unit]
Description=my-data-hub control API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=mydatahub
Group=mydatahub
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/my-data-hub.env
ExecStart=/opt/my-data-hub/venv/bin/my-data-hub api serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/my-data-hub/artifacts

[Install]
WantedBy=multi-user.target
