[Unit]
Description=my-data-hub PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=mydatahub-backup
Group=mydatahub-backup
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/backup.env
ExecStart=/opt/my-data-hub/current/scripts/backup_postgres.sh
StateDirectory=my-data-hub/backups
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/my-data-hub/backups
