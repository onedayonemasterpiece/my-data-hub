[Unit]
Description=my-data-hub PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=mydatahub
Group=mydatahub
WorkingDirectory=/opt/my-data-hub/current
EnvironmentFile=/etc/my-data-hub/my-data-hub.env
ExecStart=/opt/my-data-hub/current/scripts/backup_postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/my-data-hub/backups
