# Copy to .state/control-plane/voice-intake.env on devstand and chmod 600.
# Never commit the populated file.

MY_DATA_HUB_VOICE_INTAKE_ENABLED=true
MY_DATA_HUB_VOICE_DEVICE_TOKEN=replace-with-32-plus-random-visible-characters

# Only explicitly allowed Gemini Flash-Lite models are accepted.
MY_DATA_HUB_VOICE_MODEL=gemini-3.1-flash-lite
MY_DATA_HUB_VOICE_ALLOWED_MODELS=gemini-3.1-flash-lite
MY_DATA_HUB_VOICE_PROVIDER_TIMEOUT_SECONDS=180
MY_DATA_HUB_VOICE_MAX_AUDIO_BYTES=8388608
MY_DATA_HUB_VOICE_MAX_JSON_BYTES=2097152

# The host's existing `gh` authentication is used only to obtain this private
# runtime token once: `gh auth token`. The token must be able to write
# onedayonemasterpiece/idea-hub and is never sent to Android.
MY_DATA_HUB_VOICE_GITHUB_TOKEN=replace-from-gh-auth-token
MY_DATA_HUB_VOICE_GITHUB_REPOSITORY=onedayonemasterpiece/idea-hub
MY_DATA_HUB_VOICE_GITHUB_BRANCH=main

# Canonical shared limiter. These normally already exist in the provider env;
# duplicate them here only when the voice overlay is deployed independently.
GOOGLE_AI_LIMITER_SUPABASE_URL=https://replace.supabase.co
GOOGLE_AI_LIMITER_SUPABASE_SERVICE_KEY=replace-service-role-key
GOOGLE_AI_NORMAL_KEY_ENVS=GOOGLE_API_KEY
GOOGLE_API_KEY=replace-google-key
