---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import InterestButton from '../../components/InterestButton.astro';
import ShareButton from '../../components/ShareButton.astro';
import { loadShowcase } from '../../lib/showcase-data.mjs';
import { cardPath, cardImage, maturityLabel } from '../../lib/presentation.mjs';
import interactionsUrl from '../../scripts/showcase-share.js?url&no-inline';
export function getStaticPaths() { return loadShowcase().items.map((item,index) => ({ params: { id: item.id }, props: { item,index } })); }
const { item,index } = Astro.props;
const status = maturityLabel(item.maturity);
---
<BaseLayout title={item.title} description={item.summary} image={cardImage(item.id)} backHref="/">
  <main class="detail-page">
    <article class="detail-hero">
      <div class="idea-card__heading"><span class="card-number">#{item.display_number || index + 1}</span><Badge label={status.label} tone={status.tone} /></div>
      <h1>{item.title}</h1>
      <p>{item.summary}</p>
      <p class="card-audience">{item.for_whom.join(' · ')}</p>
    </article>
    <section class="detail-section"><h2>Что вы получите</h2><p>{item.benefit}</p></section>
    <section class="detail-section"><h2>Что потребуется от вас</h2><ul>{item.requirements.map((value) => <li>{value}</li>)}</ul></section>
    <section class="detail-section"><h2>Что уже проверено</h2><ul>{item.available.map((value) => <li>{value}</li>)}</ul></section>
    <div class="detail-actions"><InterestButton id={item.id} title={item.title}/><ShareButton title={item.title} text={item.summary} image={cardImage(item.id)} url={cardPath(item.id)} /></div>
    <ContactFooter />
  </main>
  <script type="module" src={interactionsUrl}></script>
</BaseLayout>
