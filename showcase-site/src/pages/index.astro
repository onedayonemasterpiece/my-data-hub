---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdeaCard from '../components/IdeaCard.astro';
import { loadShowcase } from '../lib/showcase-data.mjs';
import showcaseFiltersUrl from '../scripts/showcase-filters.js?url&no-inline';
import showcaseShareUrl from '../scripts/showcase-share.js?url&no-inline';
import ShareButton from '../components/ShareButton.astro';

const showcase = loadShowcase();
const { view, items } = showcase;
const options = (key) => [...new Map(items.map((item) => [item[key].id, item[key].label])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1], 'ru'));
---
<BaseLayout title={view.title} description={view.subtitle}>
  <header class="hero">
    <p class="eyebrow">IdeaHub Showcase</p>
    <h1>{view.title}</h1>
    <p class="hero__subtitle">{view.subtitle}</p>
    <p class="secret-note"><span aria-hidden="true">⌁</span> {view.access_label}</p>
  </header>

  <section class="controls" aria-label="Поиск и фильтры">
    <label class="search-field">
      <span class="sr-only">Поиск</span>
      <span aria-hidden="true">⌕</span>
      <input id="showcase-search" type="search" placeholder="Поиск идей, задач, возможностей…" autocomplete="off" />
    </label>
    <div class="filter-row">
      <label>
        <span class="sr-only">Для кого</span>
        <select data-showcase-filter="audience">
          <option value="">Для кого</option>
          {options('audience').map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label>
        <span class="sr-only">Задача</span>
        <select data-showcase-filter="category">
          <option value="">Задача</option>
          {options('category').map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      {items.some((item) => item.capability_type) && <label>
        <span class="sr-only">Тип решения</span>
        <select data-showcase-filter="capabilityType"><option value="">Тип решения</option><option value="technical">Техническое</option><option value="product">Продуктовое</option><option value="business">Бизнесовое</option></select>
      </label>}
      <label>
        <span class="sr-only">Готовность</span>
        <select data-showcase-filter="maturity">
          <option value="">Готовность</option>
          {options('maturity').map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label>
        <span class="sr-only">Ресурсоёмкость</span>
        <select data-showcase-filter="effort">
          <option value="">Ресурсоёмкость</option>
          {options('effort').map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
    </div>
  </section>

  <main>
    <p id="showcase-result-count" class="result-count" aria-live="polite">{items.length} возможностей</p>
    <div class="card-list">
      {items.map((item) => <IdeaCard item={item} />)}
    </div>
    <p id="showcase-empty" class="empty-state" hidden>По этим условиям карточек пока нет.</p>
  </main>

  <footer class="contact-card">
    <span class="contact-card__icon" aria-hidden="true">💬</span>
    <div>
      <strong>{view.contact.title}</strong>
      <p>{view.contact.label}: <a href={view.contact.href} rel="noreferrer">{view.contact.value}</a></p>
    </div>
  </footer>

  <ShareButton title={view.title} text={view.subtitle} image={`${import.meta.env.BASE_URL.replace(/\/$/u, '')}/share/idea-hub.svg`} />
  <script type="module" src={showcaseFiltersUrl}></script>
  <script type="module" src={showcaseShareUrl}></script>
</BaseLayout>
