---
interface Props { title: string; text: string; image: string; }
const { title, text, image } = Astro.props;
---
<div class="share-controls" data-share data-share-title={title} data-share-text={text} data-share-image={image}>
  <button class="share-button" type="button" data-share-button>Поделиться</button>
  <button class="share-copy" type="button" data-share-copy>Скопировать ссылку</button>
  <a class="share-download" href={image} download>Скачать визитку</a>
  <span class="sr-only" aria-live="polite" data-share-status></span>
</div>
