---
import Badge from './Badge.astro';
import CardChips from './CardChips.astro';
import ShareButton from './ShareButton.astro';
import InterestButton from './InterestButton.astro';
import { maturityLabel, cardPath, cardImage } from '../lib/presentation.mjs';
const { item, index = 0 } = Astro.props;
const status = maturityLabel(item.maturity);
---
<article class="idea-card" data-showcase-card data-item-id={item.id}
  data-audience={item.audience.id} data-audiences={(item.audiences?.length ? item.audiences : [item.audience]).map((audience) => audience.id).join(' ')}
  data-category={item.category.id}
  data-capability-type={item.capability_type || ''} data-maturity={item.maturity.id}
  data-effort={item.effort.id} data-search={item.search_text}>
  <div class="idea-card__body">
    <div class="idea-card__heading">
      <span class="card-number" aria-label={`Карточка ${item.display_number || index + 1}`}>#{item.display_number || index + 1}</span>
      <Badge label={status.label} tone={status.tone} />
    </div>
    <h2><a href={cardPath(item.id)}>{item.title}</a></h2>
    <p class="card-result">{item.benefit || item.summary}</p>
    <CardChips item={item} />
  </div>
  <div class="card-actions">
    <a class="idea-card__link" href={cardPath(item.id)}>Подробнее <span aria-hidden="true">→</span></a>
    <InterestButton id={item.id} title={item.title} />
    <ShareButton title={item.title} text={item.summary} image={cardImage(item.id)} url={cardPath(item.id)} compact />
  </div>
</article>
