# Copy to .env. Never commit real values.
POSTGRES_DB=my_data_hub
POSTGRES_USER=my_data_hub
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_PORT=5432

MY_DATA_HUB_DATABASE_URL=postgresql://my_data_hub:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/my_data_hub
MY_DATA_HUB_MIGRATOR_DATABASE_URL=
MY_DATA_HUB_APPLICATION_DATABASE_URL=
MY_DATA_HUB_CONNECTOR_INTAKE_DATABASE_URL=
MY_DATA_HUB_ORCHESTRATOR_DATABASE_URL=
MY_DATA_HUB_CANONICAL_COMMITTER_DATABASE_URL=
MY_DATA_HUB_MONITORING_DATABASE_URL=
MY_DATA_HUB_MIGRATION_OPERATOR_DATABASE_URL=
MY_DATA_HUB_ENVIRONMENT=development
MY_DATA_HUB_INSTANCE_ID=devstand-1
MY_DATA_HUB_LOG_LEVEL=INFO
MY_DATA_HUB_ARTIFACT_ROOT=/var/lib/my-data-hub/artifacts

MY_DATA_HUB_API_HOST=0.0.0.0
MY_DATA_HUB_API_PORT=8080
MY_DATA_HUB_WORKER_RESULT_TOKEN=CHANGE_ME_LONG_RANDOM_WORKER_TOKEN
MY_DATA_HUB_WORKER_RESULT_MAX_BYTES=4194304

# Both gates are false by default. Enabling the scheduler still does not enable publication.
MY_DATA_HUB_SCHEDULER_ENABLED=false
MY_DATA_HUB_PRODUCTION_PUBLISH_ENABLED=false
MY_DATA_HUB_ORCHESTRATOR_INTERVAL_SECONDS=60
MY_DATA_HUB_ORCHESTRATOR_BATCH_SIZE=25
MY_DATA_HUB_ORCHESTRATOR_LEASE_SECONDS=1800

# MCP defaults to local stdio and read-only scopes. Do not add write scopes casually.
MY_DATA_HUB_MCP_REMOTE_ENABLED=false
MY_DATA_HUB_MCP_WRITE_ENABLED=false
MY_DATA_HUB_MCP_OPERATOR_PROFILE_ENABLED=false
MY_DATA_HUB_MCP_HOST=127.0.0.1
MY_DATA_HUB_MCP_PORT=8765
MY_DATA_HUB_MCP_AUTH_MODE=stdio-environment
MY_DATA_HUB_MCP_DEVELOPMENT_TOKEN=
MY_DATA_HUB_MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
MY_DATA_HUB_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MY_DATA_HUB_MCP_SCOPES=hub:read,orchestrator:read,region-talk:read,migration:read,connector:read,provider:read
MY_DATA_HUB_MCP_OAUTH_ISSUER=
MY_DATA_HUB_MCP_OAUTH_AUDIENCE=https://mcp-datahub.kenigevents.ru/mcp
MY_DATA_HUB_MCP_OAUTH_RESOURCE=https://mcp-datahub.kenigevents.ru/mcp
MY_DATA_HUB_MCP_OAUTH_JWKS_URL=
MY_DATA_HUB_MCP_OAUTH_ALGORITHMS=RS256
MY_DATA_HUB_MCP_TRUSTED_PROXIES=
MY_DATA_HUB_MCP_TOKEN_MAX_LIFETIME_SECONDS=3600
MY_DATA_HUB_MCP_REVOCATION_DATABASE_URL=
MY_DATA_HUB_MCP_READER_DATABASE_URL=

# Connector principals are bound explicitly as {connector_id: bearer token}. Keep JSON secret.
MY_DATA_HUB_CONNECTOR_CREDENTIALS_JSON={}
MY_DATA_HUB_CONNECTOR_INTAKE_MAX_BYTES=2097152

# Host-side backup/restore uses the loopback PostgreSQL port exposed by Compose.
MY_DATA_HUB_BACKUP_DATABASE_URL=
MY_DATA_HUB_BACKUP_ROOT=/var/lib/my-data-hub/backups
MY_DATA_HUB_BACKUP_RETENTION_DAYS=14
MY_DATA_HUB_BACKUP_AGE_RECIPIENT=
MY_DATA_HUB_BACKUP_SOURCE_INSTANCE=devstand-1
MY_DATA_HUB_BACKUP_SOURCE_ENVIRONMENT=development
MY_DATA_HUB_RESTORE_DATABASE_URL=

# Region Talk YDB migration: read-only credentials are supplied only on the migration host.
YDB_ENDPOINT=
YDB_DATABASE=
YDB_ACCESS_TOKEN_CREDENTIALS=
MY_DATA_HUB_REGION_TALK_YDB_TABLE=
MY_DATA_HUB_REGION_TALK_EXPORT_ROOT=./artifacts/migration/region-talk
