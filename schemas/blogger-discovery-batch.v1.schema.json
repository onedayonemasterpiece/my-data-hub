{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.my-data-hub.local/blogger-discovery-batch.v1.schema.json",
  "$defs": {
    "BloggerDiscoveryRow": {
      "additionalProperties": false,
      "properties": {
        "source_record_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "actor_kind": {
          "enum": [
            "person",
            "organisation",
            "outlet",
            "collective",
            "unknown"
          ],
          "title": "Actor Kind",
          "type": "string"
        },
        "display_name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "canonical_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Name"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "accounts": {
          "items": {
            "$ref": "#/$defs/DiscoveryAccount"
          },
          "maxItems": 25,
          "minItems": 1,
          "title": "Accounts",
          "type": "array"
        },
        "source_uri": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Source Uri",
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/@\\s#]+(?:[/?][^#]*)?$"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 20,
          "title": "Evidence",
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "required": [
        "source_record_id",
        "actor_kind",
        "display_name",
        "accounts",
        "source_uri",
        "observed_at"
      ],
      "title": "BloggerDiscoveryRow",
      "type": "object"
    },
    "DiscoveryAccount": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Platform",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "handle": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handle"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^/@\\s#]+(?:[/?][^#]*)?$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "normalized_url": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^/@\\s#]+(?:[/?][^#]*)?$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Url"
        }
      },
      "required": [
        "platform"
      ],
      "title": "DiscoveryAccount",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "external_id"
          ],
          "properties": {
            "external_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "ObservedPeriod": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timezone": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "title": "ObservedPeriod",
      "type": "object"
    },
    "ProviderArtifactClaim": {
      "additionalProperties": false,
      "description": "Exact immutable private provider claim, never an arbitrary/latest URL.",
      "properties": {
        "resource_ref": {
          "maxLength": 400,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Resource Ref",
          "type": "string"
        },
        "control_class": {
          "enum": [
            "mcp_exchange",
            "mcp_managed"
          ],
          "title": "Control Class",
          "type": "string"
        },
        "provider_version": {
          "minimum": 1,
          "title": "Provider Version",
          "type": "integer"
        },
        "path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Path",
          "type": "string",
          "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])(?:\\.|\\.\\.)(?:[\\\\/]|$))(?!.*[\\\\/]{2})[^\\\\/]+(?:[\\\\/][^\\\\/]+)*$"
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/jsonl",
            "application/x-ndjson"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "byte_size": {
          "maximum": 10737418240,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "claim_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Claim Sha256",
          "type": "string"
        },
        "record_count": {
          "maximum": 500,
          "minimum": 1,
          "title": "Record Count",
          "type": "integer"
        }
      },
      "required": [
        "resource_ref",
        "control_class",
        "provider_version",
        "path",
        "media_type",
        "byte_size",
        "sha256",
        "claim_sha256",
        "record_count"
      ],
      "title": "ProviderArtifactClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "submit-discovery-batch.v1",
      "default": "submit-discovery-batch.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 300,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "project_slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,99}$",
      "title": "Project Slug",
      "type": "string"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "observed_period": {
      "$ref": "#/$defs/ObservedPeriod"
    },
    "rows": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/BloggerDiscoveryRow"
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows"
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderArtifactClaim"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "batch_id",
    "idempotency_key",
    "project_slug",
    "produced_at",
    "observed_period"
  ],
  "title": "SubmitDiscoveryBatch",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array"
        },
        "artifact": {
          "type": "null"
        }
      }
    },
    {
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ProviderArtifactClaim"
        },
        "rows": {
          "type": "null"
        }
      }
    }
  ]
}
