{
  "$defs": {
    "MasterAcceptanceScenario": {
      "enum": [
        "FM04",
        "FM07",
        "FM08",
        "FM09",
        "FM10",
        "FM11",
        "FM12",
        "FM24"
      ],
      "title": "MasterAcceptanceScenario",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "my-data-hub-master-lifecycle-acceptance.v1",
      "default": "my-data-hub-master-lifecycle-acceptance.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/MasterAcceptanceScenario"
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Revision",
      "type": "string"
    },
    "target_operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Operation Id"
    }
  },
  "required": [
    "task_id",
    "scenario",
    "idempotency_key",
    "source_revision"
  ],
  "title": "MasterAcceptanceRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.my-data-hub.local/acceptance/master-lifecycle-request.v1.schema.json"
}
