{
  "$defs": {
    "CallbackLossEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CALLBACK_LOSS_RECOVERY",
          "title": "Kind",
          "type": "string"
        },
        "callback_suppressed_once": {
          "const": true,
          "title": "Callback Suppressed Once",
          "type": "boolean"
        },
        "exact_event_id": {
          "format": "uuid",
          "title": "Exact Event Id",
          "type": "string"
        },
        "exact_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exact Body Sha256",
          "type": "string"
        },
        "control_boot_id_before": {
          "format": "uuid",
          "title": "Control Boot Id Before",
          "type": "string"
        },
        "control_boot_id_after": {
          "format": "uuid",
          "title": "Control Boot Id After",
          "type": "string"
        },
        "replay_disposition": {
          "enum": [
            "accepted",
            "duplicate"
          ],
          "title": "Replay Disposition",
          "type": "string"
        },
        "service_active_after_recovery": {
          "const": true,
          "title": "Service Active After Recovery",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "callback_suppressed_once",
        "exact_event_id",
        "exact_body_sha256",
        "control_boot_id_before",
        "control_boot_id_after",
        "replay_disposition",
        "service_active_after_recovery"
      ],
      "title": "CallbackLossEvidence",
      "type": "object"
    },
    "CleanDrainEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CLEAN_DRAIN",
          "title": "Kind",
          "type": "string"
        },
        "write_gate_closed": {
          "const": true,
          "title": "Write Gate Closed",
          "type": "boolean"
        },
        "checkpoint_id": {
          "format": "uuid",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "exact_version_ref": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[1-9][0-9]*$",
          "title": "Exact Version Ref",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "exact_readback_verified": {
          "const": true,
          "title": "Exact Readback Verified",
          "type": "boolean"
        },
        "restore_smoke_verified": {
          "const": true,
          "title": "Restore Smoke Verified",
          "type": "boolean"
        },
        "head_promoted": {
          "const": true,
          "title": "Head Promoted",
          "type": "boolean"
        },
        "terminal_state": {
          "const": "STOPPED",
          "title": "Terminal State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "write_gate_closed",
        "checkpoint_id",
        "exact_version_ref",
        "manifest_sha256",
        "exact_readback_verified",
        "restore_smoke_verified",
        "head_promoted",
        "terminal_state"
      ],
      "title": "CleanDrainEvidence",
      "type": "object"
    },
    "ConcurrentEnsureEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CONCURRENT_ENSURE_SINGLE_RUN",
          "title": "Kind",
          "type": "string"
        },
        "request_count": {
          "const": 20,
          "title": "Request Count",
          "type": "integer"
        },
        "operation_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 20,
          "title": "Operation Ids",
          "type": "array"
        },
        "provider_run_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 20,
          "title": "Provider Run Refs",
          "type": "array"
        },
        "provider_kernel_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 20,
          "minItems": 20,
          "title": "Provider Kernel Ids",
          "type": "array"
        },
        "epochs": {
          "items": {
            "type": "integer"
          },
          "maxItems": 20,
          "minItems": 20,
          "title": "Epochs",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "request_count",
        "operation_ids",
        "provider_run_refs",
        "provider_kernel_ids",
        "epochs"
      ],
      "title": "ConcurrentEnsureEvidence",
      "type": "object"
    },
    "EmptyBootstrapEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "EMPTY_MASTER_BOOTSTRAP",
          "title": "Kind",
          "type": "string"
        },
        "boot_source": {
          "const": "empty_baseline",
          "title": "Boot Source",
          "type": "string"
        },
        "canonical_revision": {
          "const": 0,
          "title": "Canonical Revision",
          "type": "integer"
        },
        "canonical_row_count": {
          "const": 0,
          "title": "Canonical Row Count",
          "type": "integer"
        },
        "service_active": {
          "const": true,
          "title": "Service Active",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "boot_source",
        "canonical_revision",
        "canonical_row_count",
        "service_active"
      ],
      "title": "EmptyBootstrapEvidence",
      "type": "object"
    },
    "LeaseExpiryEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "LEASE_EXPIRY_DENIAL",
          "title": "Kind",
          "type": "string"
        },
        "observed_wait_seconds": {
          "maximum": 900,
          "minimum": 60,
          "title": "Observed Wait Seconds",
          "type": "integer"
        },
        "lease_expired": {
          "const": true,
          "title": "Lease Expired",
          "type": "boolean"
        },
        "bounded_operator_dml_denied": {
          "const": true,
          "title": "Bounded Operator Dml Denied",
          "type": "boolean"
        },
        "transaction_state": {
          "const": "rollback_only",
          "title": "Transaction State",
          "type": "string"
        },
        "operator_operation_id": {
          "format": "uuid",
          "title": "Operator Operation Id",
          "type": "string"
        },
        "operator_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operator Receipt Sha256",
          "type": "string"
        },
        "denial_code": {
          "const": "MDH_EPOCH_LEASE_EXPIRED",
          "title": "Denial Code",
          "type": "string"
        },
        "canonical_revision_before": {
          "minimum": 0,
          "title": "Canonical Revision Before",
          "type": "integer"
        },
        "canonical_revision_after": {
          "minimum": 0,
          "title": "Canonical Revision After",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "observed_wait_seconds",
        "lease_expired",
        "bounded_operator_dml_denied",
        "transaction_state",
        "operator_operation_id",
        "operator_receipt_sha256",
        "denial_code",
        "canonical_revision_before",
        "canonical_revision_after"
      ],
      "title": "LeaseExpiryEvidence",
      "type": "object"
    },
    "MasterAcceptanceBinding": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "service_instance_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Service Instance Id",
          "type": "string"
        },
        "master_instance_id": {
          "format": "uuid",
          "title": "Master Instance Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "run_id",
        "attempt_id",
        "service_instance_id",
        "master_instance_id",
        "epoch"
      ],
      "title": "MasterAcceptanceBinding",
      "type": "object"
    },
    "MasterAcceptanceCommandKind": {
      "enum": [
        "EMPTY_MASTER_BOOTSTRAP",
        "CONCURRENT_ENSURE_SINGLE_RUN",
        "CALLBACK_LOSS_RECOVERY",
        "STALE_REPLAY_REJECTION",
        "LEASE_EXPIRY_DENIAL",
        "OLD_EPOCH_RETURN_DENIAL",
        "CLEAN_DRAIN",
        "SESSION_ROTATION_SOAK"
      ],
      "title": "MasterAcceptanceCommandKind",
      "type": "string"
    },
    "MasterAcceptanceScenario": {
      "enum": [
        "FM04",
        "FM07",
        "FM08",
        "FM09",
        "FM10",
        "FM11",
        "FM12",
        "FM24"
      ],
      "title": "MasterAcceptanceScenario",
      "type": "string"
    },
    "OldEpochEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "OLD_EPOCH_RETURN_DENIAL",
          "title": "Kind",
          "type": "string"
        },
        "old_epoch": {
          "minimum": 1,
          "title": "Old Epoch",
          "type": "integer"
        },
        "new_epoch": {
          "minimum": 2,
          "title": "New Epoch",
          "type": "integer"
        },
        "old_runtime_draining_before_rotation": {
          "const": true,
          "title": "Old Runtime Draining Before Rotation",
          "type": "boolean"
        },
        "renew_denied": {
          "const": true,
          "title": "Renew Denied",
          "type": "boolean"
        },
        "register_denied": {
          "const": true,
          "title": "Register Denied",
          "type": "boolean"
        },
        "bounded_write_denied": {
          "const": true,
          "title": "Bounded Write Denied",
          "type": "boolean"
        },
        "tunnel_denied": {
          "const": true,
          "title": "Tunnel Denied",
          "type": "boolean"
        },
        "new_epoch_active": {
          "const": true,
          "title": "New Epoch Active",
          "type": "boolean"
        },
        "old_operation_id": {
          "format": "uuid",
          "title": "Old Operation Id",
          "type": "string"
        },
        "new_operation_id": {
          "format": "uuid",
          "title": "New Operation Id",
          "type": "string"
        },
        "handoff_checkpoint_id": {
          "format": "uuid",
          "title": "Handoff Checkpoint Id",
          "type": "string"
        },
        "write_denial_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Write Denial Receipt Sha256",
          "type": "string"
        },
        "tunnel_denial_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tunnel Denial Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "old_epoch",
        "new_epoch",
        "old_runtime_draining_before_rotation",
        "renew_denied",
        "register_denied",
        "bounded_write_denied",
        "tunnel_denied",
        "new_epoch_active",
        "old_operation_id",
        "new_operation_id",
        "handoff_checkpoint_id",
        "write_denial_receipt_sha256",
        "tunnel_denial_receipt_sha256"
      ],
      "title": "OldEpochEvidence",
      "type": "object"
    },
    "RotationSoakEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "SESSION_ROTATION_SOAK",
          "title": "Kind",
          "type": "string"
        },
        "monotonic_started_ns": {
          "minimum": 0,
          "title": "Monotonic Started Ns",
          "type": "integer"
        },
        "monotonic_finished_ns": {
          "minimum": 0,
          "title": "Monotonic Finished Ns",
          "type": "integer"
        },
        "observed_duration_seconds": {
          "maximum": 5400,
          "minimum": 3600,
          "title": "Observed Duration Seconds",
          "type": "integer"
        },
        "session_rotations": {
          "maximum": 200,
          "minimum": 12,
          "title": "Session Rotations",
          "type": "integer"
        },
        "lease_renewals": {
          "maximum": 400,
          "minimum": 12,
          "title": "Lease Renewals",
          "type": "integer"
        },
        "tunnel_renewals": {
          "maximum": 400,
          "minimum": 12,
          "title": "Tunnel Renewals",
          "type": "integer"
        },
        "rejected_stale_sessions": {
          "maximum": 400,
          "minimum": 1,
          "title": "Rejected Stale Sessions",
          "type": "integer"
        },
        "remained_single_epoch": {
          "const": true,
          "title": "Remained Single Epoch",
          "type": "boolean"
        },
        "service_active_at_end": {
          "const": true,
          "title": "Service Active At End",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "monotonic_started_ns",
        "monotonic_finished_ns",
        "observed_duration_seconds",
        "session_rotations",
        "lease_renewals",
        "tunnel_renewals",
        "rejected_stale_sessions",
        "remained_single_epoch",
        "service_active_at_end"
      ],
      "title": "RotationSoakEvidence",
      "type": "object"
    },
    "StaleReplayEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "STALE_REPLAY_REJECTION",
          "title": "Kind",
          "type": "string"
        },
        "exact_event_id": {
          "format": "uuid",
          "title": "Exact Event Id",
          "type": "string"
        },
        "exact_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exact Body Sha256",
          "type": "string"
        },
        "duplicate_disposition": {
          "const": "duplicate",
          "title": "Duplicate Disposition",
          "type": "string"
        },
        "stale_runtime_auth_rejected": {
          "const": true,
          "title": "Stale Runtime Auth Rejected",
          "type": "boolean"
        },
        "stale_epoch_rejected": {
          "const": true,
          "title": "Stale Epoch Rejected",
          "type": "boolean"
        },
        "state_sha256_before": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Sha256 Before",
          "type": "string"
        },
        "state_sha256_after": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Sha256 After",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "exact_event_id",
        "exact_body_sha256",
        "duplicate_disposition",
        "stale_runtime_auth_rejected",
        "stale_epoch_rejected",
        "state_sha256_before",
        "state_sha256_after"
      ],
      "title": "StaleReplayEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "my-data-hub-master-lifecycle-receipt.v1",
      "default": "my-data-hub-master-lifecycle-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/MasterAcceptanceScenario"
    },
    "command_kind": {
      "$ref": "#/$defs/MasterAcceptanceCommandKind"
    },
    "binding": {
      "$ref": "#/$defs/MasterAcceptanceBinding"
    },
    "evidence_class": {
      "const": "live",
      "title": "Evidence Class",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "evidence": {
      "discriminator": {
        "mapping": {
          "CALLBACK_LOSS_RECOVERY": "#/$defs/CallbackLossEvidence",
          "CLEAN_DRAIN": "#/$defs/CleanDrainEvidence",
          "CONCURRENT_ENSURE_SINGLE_RUN": "#/$defs/ConcurrentEnsureEvidence",
          "EMPTY_MASTER_BOOTSTRAP": "#/$defs/EmptyBootstrapEvidence",
          "LEASE_EXPIRY_DENIAL": "#/$defs/LeaseExpiryEvidence",
          "OLD_EPOCH_RETURN_DENIAL": "#/$defs/OldEpochEvidence",
          "SESSION_ROTATION_SOAK": "#/$defs/RotationSoakEvidence",
          "STALE_REPLAY_REJECTION": "#/$defs/StaleReplayEvidence"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/EmptyBootstrapEvidence"
        },
        {
          "$ref": "#/$defs/ConcurrentEnsureEvidence"
        },
        {
          "$ref": "#/$defs/CallbackLossEvidence"
        },
        {
          "$ref": "#/$defs/StaleReplayEvidence"
        },
        {
          "$ref": "#/$defs/LeaseExpiryEvidence"
        },
        {
          "$ref": "#/$defs/OldEpochEvidence"
        },
        {
          "$ref": "#/$defs/CleanDrainEvidence"
        },
        {
          "$ref": "#/$defs/RotationSoakEvidence"
        }
      ],
      "title": "Evidence"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "command_sha256",
    "task_id",
    "scenario",
    "command_kind",
    "binding",
    "evidence_class",
    "outcome",
    "evidence",
    "completed_at"
  ],
  "title": "MasterAcceptanceReceipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.my-data-hub.local/acceptance/master-lifecycle-receipt.v1.schema.json"
}
