{
  "$id": "https://my-data-hub.invalid/schemas/region-talk-ydb-protected-export-receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_directory_mode": {
      "const": "0700",
      "default": "0700",
      "title": "Artifact Directory Mode",
      "type": "string"
    },
    "complete": {
      "const": true,
      "default": true,
      "title": "Complete",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_file_mode": {
      "const": "0600",
      "default": "0600",
      "title": "Data File Mode",
      "type": "string"
    },
    "data_file_path": {
      "const": "rows-000001.jsonl",
      "default": "rows-000001.jsonl",
      "title": "Data File Path",
      "type": "string"
    },
    "data_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Data File Sha256",
      "type": "string"
    },
    "export_batch_id": {
      "format": "uuid",
      "title": "Export Batch Id",
      "type": "string"
    },
    "logical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Logical Sha256",
      "type": "string"
    },
    "manifest_mode": {
      "const": "0600",
      "default": "0600",
      "title": "Manifest Mode",
      "type": "string"
    },
    "manifest_path": {
      "const": "manifest.json",
      "default": "manifest.json",
      "title": "Manifest Path",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "raw_data_committed_to_git": {
      "const": false,
      "default": false,
      "title": "Raw Data Committed To Git",
      "type": "boolean"
    },
    "receipt_mode": {
      "const": "0600",
      "default": "0600",
      "title": "Receipt Mode",
      "type": "string"
    },
    "record_id_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Id Set Sha256",
      "type": "string"
    },
    "row_count": {
      "exclusiveMinimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "my-data-hub.region-talk-ydb-protected-export-receipt.v1",
      "default": "my-data-hub.region-talk-ydb-protected-export-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_at": {
      "format": "date-time",
      "title": "Snapshot At",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Revision",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "manifest_sha256",
    "export_batch_id",
    "snapshot_at",
    "source_revision",
    "row_count",
    "logical_sha256",
    "record_id_set_sha256",
    "data_file_sha256"
  ],
  "title": "ProtectedExportReceipt",
  "type": "object"
}
