{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-data-hub.invalid/schemas/embeddings/embedding-production-request.v1.schema.json",
  "title": "EmbeddingProductionRequest",
  "$defs": {
    "EmbeddingModelContract": {
      "additionalProperties": false,
      "description": "Exact, immutable identity and encoder behavior for one vector space.",
      "properties": {
        "model_key": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Model Key",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "dimensions": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "max_tokens": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "pooling": {
          "enum": [
            "attention_mask_mean",
            "model_native_dense"
          ],
          "title": "Pooling",
          "type": "string"
        },
        "normalization": {
          "const": "l2",
          "title": "Normalization",
          "type": "string"
        },
        "query_prefix": {
          "title": "Query Prefix",
          "type": "string"
        },
        "document_prefix": {
          "title": "Document Prefix",
          "type": "string"
        },
        "output_modes": {
          "items": {
            "const": "dense",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Output Modes",
          "type": "array"
        },
        "encoder_contract_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Encoder Contract Version",
          "type": "string"
        },
        "vector_space": {
          "pattern": "^[a-z][a-z0-9_]{0,99}$",
          "title": "Vector Space",
          "type": "string"
        }
      },
      "required": [
        "model_key",
        "revision",
        "dimensions",
        "max_tokens",
        "pooling",
        "normalization",
        "query_prefix",
        "document_prefix",
        "output_modes",
        "encoder_contract_version",
        "vector_space"
      ],
      "title": "EmbeddingModelContract",
      "type": "object"
    },
    "WorkerAsset": {
      "additionalProperties": false,
      "properties": {
        "notebook_slug": {
          "maxLength": 100,
          "pattern": "^[a-z0-9-]+$",
          "title": "Notebook Slug",
          "type": "string"
        },
        "notebook_path": {
          "pattern": "^notebooks/[a-z0-9-]+/worker\\.ipynb$",
          "title": "Notebook Path",
          "type": "string"
        },
        "primary_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Primary Source Sha256",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/EmbeddingModelContract"
        }
      },
      "required": [
        "notebook_slug",
        "notebook_path",
        "primary_source_sha256",
        "model"
      ],
      "title": "WorkerAsset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "my-data-hub-embedding-production-request.v1",
      "default": "my-data-hub-embedding-production-request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "idempotency_key_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Idempotency Key Sha256",
      "type": "string"
    },
    "blogger_receipt_id": {
      "format": "uuid",
      "title": "Blogger Receipt Id",
      "type": "string"
    },
    "blogger_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Blogger Receipt Sha256",
      "type": "string"
    },
    "blogger_canonical_revision": {
      "minimum": 1,
      "title": "Blogger Canonical Revision",
      "type": "integer"
    },
    "blogger_checkpoint_id": {
      "format": "uuid",
      "title": "Blogger Checkpoint Id",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Revision",
      "type": "string"
    },
    "expected_documents_per_model": {
      "const": 266,
      "default": 266,
      "title": "Expected Documents Per Model",
      "type": "integer"
    },
    "worker_assets": {
      "default": [
        {
          "notebook_slug": "05-e5-blogger-embedding-worker",
          "notebook_path": "notebooks/05-e5-blogger-embedding-worker/worker.ipynb",
          "primary_source_sha256": "9cfe2210c0f6d689445aadf917f1638dcaa173178e36f48832e91bfdeeafebfd",
          "model": {
            "dimensions": 768,
            "document_prefix": "passage: ",
            "encoder_contract_version": "e5-attention-mask-mean-l2-prefixes-max512.v1",
            "max_tokens": 512,
            "model_key": "intfloat/multilingual-e5-base",
            "normalization": "l2",
            "output_modes": [
              "dense"
            ],
            "pooling": "attention_mask_mean",
            "query_prefix": "query: ",
            "revision": "d128750597153bb5987e10b1c3493a34e5a4502a",
            "vector_space": "e5_multilingual_base_768_v1"
          }
        },
        {
          "notebook_slug": "06-bge-m3-blogger-embedding-worker",
          "notebook_path": "notebooks/06-bge-m3-blogger-embedding-worker/worker.ipynb",
          "primary_source_sha256": "10e26e7da6bad0e65d048debce89f25c2b8dea715e058b788e9fd5b79a654682",
          "model": {
            "dimensions": 1024,
            "document_prefix": "",
            "encoder_contract_version": "bge-m3-native-dense-only-l2.v1",
            "max_tokens": 8192,
            "model_key": "BAAI/bge-m3",
            "normalization": "l2",
            "output_modes": [
              "dense"
            ],
            "pooling": "model_native_dense",
            "query_prefix": "",
            "revision": "5617a9f61b028005a4858fdac845db406aefb181",
            "vector_space": "bge_m3_dense_1024_v1"
          }
        }
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/WorkerAsset"
        },
        {
          "$ref": "#/$defs/WorkerAsset"
        }
      ],
      "title": "Worker Assets",
      "type": "array"
    },
    "probe_query_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Probe Query Sha256",
      "type": "string"
    },
    "probe_query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "request_id",
    "idempotency_key_sha256",
    "blogger_receipt_id",
    "blogger_receipt_sha256",
    "blogger_canonical_revision",
    "blogger_checkpoint_id",
    "source_revision",
    "probe_query",
    "probe_query_sha256"
  ],
  "type": "object"
}
