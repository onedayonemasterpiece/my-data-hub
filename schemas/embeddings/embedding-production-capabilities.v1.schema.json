{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-data-hub.invalid/schemas/embeddings/embedding-production-capabilities.v1.schema.json",
  "title": "EmbeddingProductionCapabilities",
  "$defs": {
    "EmbeddingModelContract": {
      "additionalProperties": false,
      "description": "Exact, immutable identity and encoder behavior for one vector space.",
      "properties": {
        "model_key": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Model Key",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "dimensions": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "max_tokens": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "pooling": {
          "enum": [
            "attention_mask_mean",
            "model_native_dense"
          ],
          "title": "Pooling",
          "type": "string"
        },
        "normalization": {
          "const": "l2",
          "title": "Normalization",
          "type": "string"
        },
        "query_prefix": {
          "title": "Query Prefix",
          "type": "string"
        },
        "document_prefix": {
          "title": "Document Prefix",
          "type": "string"
        },
        "output_modes": {
          "items": {
            "const": "dense",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Output Modes",
          "type": "array"
        },
        "encoder_contract_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Encoder Contract Version",
          "type": "string"
        },
        "vector_space": {
          "pattern": "^[a-z][a-z0-9_]{0,99}$",
          "title": "Vector Space",
          "type": "string"
        }
      },
      "required": [
        "model_key",
        "revision",
        "dimensions",
        "max_tokens",
        "pooling",
        "normalization",
        "query_prefix",
        "document_prefix",
        "output_modes",
        "encoder_contract_version",
        "vector_space"
      ],
      "title": "EmbeddingModelContract",
      "type": "object"
    },
    "WorkerAsset": {
      "additionalProperties": false,
      "properties": {
        "notebook_slug": {
          "maxLength": 100,
          "pattern": "^[a-z0-9-]+$",
          "title": "Notebook Slug",
          "type": "string"
        },
        "notebook_path": {
          "pattern": "^notebooks/[a-z0-9-]+/worker\\.ipynb$",
          "title": "Notebook Path",
          "type": "string"
        },
        "primary_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Primary Source Sha256",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/EmbeddingModelContract"
        }
      },
      "required": [
        "notebook_slug",
        "notebook_path",
        "primary_source_sha256",
        "model"
      ],
      "title": "WorkerAsset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "my-data-hub-embedding-production-capabilities.v1",
      "default": "my-data-hub-embedding-production-capabilities.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "ready": {
      "const": true,
      "title": "Ready",
      "type": "boolean"
    },
    "execution_location": {
      "const": "active_kaggle_master",
      "title": "Execution Location",
      "type": "string"
    },
    "provider_adapter_package": {
      "const": "kaggle",
      "title": "Provider Adapter Package",
      "type": "string"
    },
    "provider_adapter_version": {
      "const": "2.2.4",
      "title": "Provider Adapter Version",
      "type": "string"
    },
    "provider_adapter_implementation": {
      "const": "my_data_hub.providers.kaggle.KaggleProviderAdapter",
      "title": "Provider Adapter Implementation",
      "type": "string"
    },
    "single_provider_adapter": {
      "const": true,
      "title": "Single Provider Adapter",
      "type": "boolean"
    },
    "transactional_import": {
      "const": true,
      "title": "Transactional Import",
      "type": "boolean"
    },
    "verified_checkpoint_restore": {
      "const": true,
      "title": "Verified Checkpoint Restore",
      "type": "boolean"
    },
    "mcp_hybrid_search": {
      "const": true,
      "title": "Mcp Hybrid Search",
      "type": "boolean"
    },
    "worker_assets": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/WorkerAsset"
        },
        {
          "$ref": "#/$defs/WorkerAsset"
        }
      ],
      "title": "Worker Assets",
      "type": "array"
    }
  },
  "required": [
    "ready",
    "execution_location",
    "provider_adapter_package",
    "provider_adapter_version",
    "provider_adapter_implementation",
    "single_provider_adapter",
    "transactional_import",
    "verified_checkpoint_restore",
    "mcp_hybrid_search",
    "worker_assets"
  ],
  "type": "object"
}
