{
  "$defs": {
    "BloggerYdbScanEvidence": {
      "additionalProperties": false,
      "description": "Bounded metadata from one ordered scan; never contains a source value.",
      "properties": {
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "row_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "distinct_record_ids": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Distinct Record Ids",
          "type": "integer"
        },
        "logical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Sha256",
          "type": "string"
        },
        "record_id_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Id Set Sha256",
          "type": "string"
        },
        "batch_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Batch Count",
          "type": "integer"
        },
        "batch_id_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Batch Id Set Sha256",
          "type": "string"
        },
        "source_file_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Source File Count",
          "type": "integer"
        },
        "source_file_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Set Sha256",
          "type": "string"
        },
        "confirmation_status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 32,
          "minProperties": 1,
          "title": "Confirmation Status Counts",
          "type": "object"
        },
        "min_updated_at": {
          "format": "date-time",
          "title": "Min Updated At",
          "type": "string"
        },
        "max_updated_at": {
          "format": "date-time",
          "title": "Max Updated At",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "completed_at",
        "row_count",
        "distinct_record_ids",
        "logical_sha256",
        "record_id_set_sha256",
        "batch_count",
        "batch_id_set_sha256",
        "source_file_count",
        "source_file_set_sha256",
        "confirmation_status_counts",
        "min_updated_at",
        "max_updated_at"
      ],
      "title": "BloggerYdbScanEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
