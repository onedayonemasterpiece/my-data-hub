      "type": "string"
    },
    "database_path": {
      "const": "/ru-central1/b1ghfk15fpug7mn5439l/etnkibjidis0o6stn2cq",
      "default": "/ru-central1/b1ghfk15fpug7mn5439l/etnkibjidis0o6stn2cq",
      "title": "Database Path",
      "type": "string"
    },
    "table": {
      "const": "region_talk_external_blogger_evidence",
      "default": "region_talk_external_blogger_evidence",
