  "title": "Region Talk metadata-only YDB source read receipt v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-data-hub.invalid/schemas/region-talk-ydb-source-read-receipt.v1.schema.json"
