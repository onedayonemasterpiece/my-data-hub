        },
        "access_bindings_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Access Bindings Sha256",
          "type": "string"
        },
        "credential_mode": {
          "const": "ephemeral_iam_token_impersonation",
          "default": "ephemeral_iam_token_impersonation",
          "title": "Credential Mode",
          "type": "string"
        },
        "database_roles": {
          "items": {
            "type": "string"
          },
          "title": "Database Roles",
          "type": "array"
        },
        "service_account_id": {
          "pattern": "^[a-z0-9]{20}$",
          "title": "Service Account Id",
          "type": "string"
        },
        "service_account_name": {
          "const": "my-data-hub-ydb-reader",
          "default": "my-data-hub-ydb-reader",
          "title": "Service Account Name",
          "type": "string"
        },
        "write_denial_verified": {
          "const": true,
