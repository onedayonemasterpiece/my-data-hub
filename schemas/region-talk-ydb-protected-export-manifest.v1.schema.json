          "type": "object"
        },
        "distinct_record_ids": {
          "exclusiveMinimum": 0,
          "title": "Distinct Record Ids",
          "type": "integer"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "logical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Sha256",
          "type": "string"
        },
        "max_updated_at": {
          "format": "date-time",
          "title": "Max Updated At",
          "type": "string"
        },
        "min_updated_at": {
          "format": "date-time",
          "title": "Min Updated At",
          "type": "string"
        },
        "record_id_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Id Set Sha256",
          "type": "string"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "source_file_count": {
          "exclusiveMinimum": 0,
          "title": "Source File Count",
          "type": "integer"
        },
        "source_file_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Set Sha256",
