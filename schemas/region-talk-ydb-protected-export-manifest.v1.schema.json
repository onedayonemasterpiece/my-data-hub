          "type": "boolean"
        },
        "write_denial_verified_at": {
          "format": "date-time",
          "title": "Write Denial Verified At",
          "type": "string"
        }
      },
      "required": [
        "service_account_id",
        "access_bindings_observed_at",
        "access_bindings_sha256",
        "database_roles",
        "write_denial_verified_at"
