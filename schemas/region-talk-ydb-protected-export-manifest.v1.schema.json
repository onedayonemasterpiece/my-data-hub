    },
    "export_batch_id": {
      "format": "uuid",
      "title": "Export Batch Id",
      "type": "string"
    },
    "inventory": {
      "$ref": "#/$defs/ObservedInventoryBinding"
    },
    "ordering": {
      "default": [
        "record_id"
      ],
      "items": {
        "const": "record_id",
        "type": "string"
      },
      "title": "Ordering",
      "type": "array"
    },
    "primary_scan": {
      "$ref": "#/$defs/ScanEvidence"
    },
    "principal": {
      "$ref": "#/$defs/ReaderPrincipalBinding"
    },
    "raw_data_committed_to_git": {
      "const": false,
      "default": false,
      "title": "Raw Data Committed To Git",
      "type": "boolean"
    },
    "schema_version": {
      "const": "my-data-hub.region-talk-ydb-protected-export-manifest.v1",
      "default": "my-data-hub.region-talk-ydb-protected-export-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_at": {
      "format": "date-time",
      "title": "Snapshot At",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceBinding"
    },
    "status": {
      "const": "COMPLETE_PROTECTED_EXPORT",
      "default": "COMPLETE_PROTECTED_EXPORT",
      "title": "Status",
      "type": "string"
    },
    "verification_scan": {
      "$ref": "#/$defs/ScanEvidence"
    }
  },
  "required": [
    "export_batch_id",
    "snapshot_at",
    "created_at",
    "source",
    "inventory",
    "principal",
    "primary_scan",
    "verification_scan",
    "data_file"
  ],
  "title": "ProtectedExportManifest",
  "type": "object"
}
