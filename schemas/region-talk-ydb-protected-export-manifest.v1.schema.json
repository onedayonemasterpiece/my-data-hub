    "SourceBinding": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "database_id": {
          "const": "etnkibjidis0o6stn2cq",
          "default": "etnkibjidis0o6stn2cq",
          "title": "Database Id",
          "type": "string"
        },
        "database_path": {
          "const": "/ru-central1/b1ghfk15fpug7mn5439l/etnkibjidis0o6stn2cq",
          "default": "/ru-central1/b1ghfk15fpug7mn5439l/etnkibjidis0o6stn2cq",
          "title": "Database Path",
          "type": "string"
        },
        "query": {
          "const": "SELECT `record_id`, `batch_id`, `list_order`, `level`, `blogger_name`, `segment`, `region_relation_status`, `visit_period_text`, `locations_text`, `confirmation_basis`, `evidence_url`, `telegram_url`, `vk_public_url`, `vk_video_url`, `rutube_url`, `source_kind`, `confirmation_status`, `pipeline_status`, `source_file_sha256`, `ingested_at`, `updated_at`, `external_region_basis`, `external_region_evidence_url`, `submission_batch_ids_json`, `other_primary_url`, `social_links_type`, `evidence_type` FROM `region_talk_external_blogger_evidence` ORDER BY `record_id`;",
          "default": "SELECT `record_id`, `batch_id`, `list_order`, `level`, `blogger_name`, `segment`, `region_relation_status`, `visit_period_text`, `locations_text`, `confirmation_basis`, `evidence_url`, `telegram_url`, `vk_public_url`, `vk_video_url`, `rutube_url`, `source_kind`, `confirmation_status`, `pipeline_status`, `source_file_sha256`, `ingested_at`, `updated_at`, `external_region_basis`, `external_region_evidence_url`, `submission_batch_ids_json`, `other_primary_url`, `social_links_type`, `evidence_type` FROM `region_talk_external_blogger_evidence` ORDER BY `record_id`;",
          "title": "Query",
          "type": "string"
        },
        "query_sha256": {
          "const": "ef94cf114fea0e2f89418c5dacbc289e5c2d21f6935883c2b685ec4f64bd0e50",
          "default": "ef94cf114fea0e2f89418c5dacbc289e5c2d21f6935883c2b685ec4f64bd0e50",
          "title": "Query Sha256",
          "type": "string"
        },
        "schema_sha256": {
          "const": "a44855556115f90c0b6353cac0b8c5d1eaebf91485ca594c621cc73f91b2564f",
          "default": "a44855556115f90c0b6353cac0b8c5d1eaebf91485ca594c621cc73f91b2564f",
          "title": "Schema Sha256",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "system": {
          "const": "ydb",
          "default": "ydb",
          "title": "System",
          "type": "string"
        },
        "table": {
          "const": "region_talk_external_blogger_evidence",
          "default": "region_talk_external_blogger_evidence",
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "columns",
        "source_revision"
      ],
      "title": "SourceBinding",
      "type": "object"
    }
  },
  "$id": "https://my-data-hub.invalid/schemas/region-talk-ydb-protected-export-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consistency_mode": {
      "const": "two_independent_QuerySnapshotReadOnly",
      "default": "two_independent_QuerySnapshotReadOnly",
      "title": "Consistency Mode",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_file": {
