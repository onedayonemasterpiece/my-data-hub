{
  "$defs": {
    "DataFileBinding": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "mode": {
          "const": "0600",
          "default": "0600",
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "const": "rows-000001.jsonl",
          "default": "rows-000001.jsonl",
          "title": "Path",
          "type": "string"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "row_count",
        "byte_size",
        "sha256"
      ],
      "title": "DataFileBinding",
      "type": "object"
    },
    "ObservedInventoryBinding": {
      "additionalProperties": false,
      "properties": {
        "batch_count": {
          "exclusiveMinimum": 0,
          "title": "Batch Count",
          "type": "integer"
        },
        "confirmation_status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 32,
          "minProperties": 1,
          "title": "Confirmation Status Counts",
          "type": "object"
        },
        "distinct_record_ids": {
          "exclusiveMinimum": 0,
          "title": "Distinct Record Ids",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "receipt_schema_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Receipt Schema Version",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "source_file_count": {
          "exclusiveMinimum": 0,
          "title": "Source File Count",
          "type": "integer"
        }
      },
      "required": [
        "receipt_schema_version",
        "receipt_sha256",
        "observed_at",
        "row_count",
        "distinct_record_ids",
        "batch_count",
        "source_file_count",
        "confirmation_status_counts"
      ],
      "title": "ObservedInventoryBinding",
      "type": "object"
    },
    "ReaderPrincipalBinding": {
      "additionalProperties": false,
      "properties": {
