          },
          "title": "Database Roles",
          "type": "array"
        },
        "access_bindings_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Access Bindings Sha256",
          "type": "string"
        },
        "write_denial_verified": {
          "const": true,
          "default": true,
          "title": "Write Denial Verified",
          "type": "boolean"
        },
        "first_scan": {
          "$ref": "#/$defs/BloggerYdbScanEvidence"
        },
        "repeat_scan": {
          "$ref": "#/$defs/BloggerYdbScanEvidence"
        }
      },
      "required": [
        "export_batch_id",
        "snapshot_at",
        "source_revision",
        "reader_service_account_id",
        "database_roles",
        "access_bindings_sha256",
        "first_scan",
        "repeat_scan"
      ],
      "type": "object",
      "title": "BloggerYdbSourceReadReceipt"
    }
  },
