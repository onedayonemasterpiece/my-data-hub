{
  "$defs": {
    "BloggerDuplicateDecision": {
      "additionalProperties": false,
      "description": "One bounded decision record; it contains no source payload fields.",
      "properties": {
        "identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        },
        "canonical_record_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Canonical Record Id",
          "type": "string"
        },
        "canonical_actor_id": {
          "format": "uuid",
          "title": "Canonical Actor Id",
          "type": "string"
        },
        "member_record_ids": {
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Member Record Ids",
          "type": "array",
          "uniqueItems": true
        },
        "decided_by": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Decided By",
          "type": "string"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "identity_sha256",
        "canonical_record_id",
        "canonical_actor_id",
        "member_record_ids",
        "decided_by",
        "reason"
      ],
      "title": "BloggerDuplicateDecision",
      "type": "object"
    },
    "BloggerDuplicateResolutionEnvelope": {
      "additionalProperties": false,
      "description": "Owner-authorized metadata binding decisions to one quarantined source request.",
      "properties": {
        "schema_version": {
          "const": "region-talk-blogger-duplicate-resolution-envelope.v1"
        },
        "authorization_id": {
          "format": "uuid",
          "title": "Authorization Id",
          "type": "string"
        },
        "authorized_by": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authorized By",
          "type": "string"
        },
        "authorized_at": {
          "format": "date-time",
          "title": "Authorized At",
          "type": "string"
        },
        "source_request_id": {
          "format": "uuid",
          "title": "Source Request Id",
          "type": "string"
        },
        "source_operation_id": {
          "format": "uuid",
          "title": "Source Operation Id",
          "type": "string"
        },
        "source_request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Request Sha256",
          "type": "string"
        },
        "export_batch_id": {
          "format": "uuid",
          "title": "Export Batch Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_at": {
          "format": "date-time",
          "title": "Snapshot At",
          "type": "string"
        },
        "expected_rows": {
          "title": "Expected Rows",
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_query_sha256": {
          "const": "ef94cf114fea0e2f89418c5dacbc289e5c2d21f6935883c2b685ec4f64bd0e50",
          "default": "ef94cf114fea0e2f89418c5dacbc289e5c2d21f6935883c2b685ec4f64bd0e50",
          "title": "Source Query Sha256",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/BloggerDuplicateDecision"
          },
          "maxItems": 500000,
          "minItems": 1,
          "title": "Decisions",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "authorization_id",
        "authorized_by",
        "authorized_at",
        "source_request_id",
        "source_operation_id",
        "source_request_sha256",
        "export_batch_id",
        "project_id",
        "snapshot_at",
        "expected_rows",
        "source_revision",
        "source_query_sha256",
        "decisions"
      ],
      "title": "BloggerDuplicateResolutionEnvelope",
      "type": "object"
    },
    "BloggerYdbScanEvidence": {
      "additionalProperties": false,
      "description": "Bounded metadata from one ordered scan; never contains a source value.",
      "properties": {
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "row_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "distinct_record_ids": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Distinct Record Ids",
          "type": "integer"
        },
        "logical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Sha256",
          "type": "string"
        },
        "record_id_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Id Set Sha256",
          "type": "string"
        },
        "batch_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Batch Count",
          "type": "integer"
        },
        "batch_id_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Batch Id Set Sha256",
          "type": "string"
        },
        "source_file_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Source File Count",
          "type": "integer"
        },
        "source_file_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Set Sha256",
          "type": "string"
        },
        "confirmation_status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 32,
          "minProperties": 1,
          "title": "Confirmation Status Counts",
          "type": "object"
        },
        "min_updated_at": {
          "format": "date-time",
          "title": "Min Updated At",
          "type": "string"
        },
        "max_updated_at": {
          "format": "date-time",
          "title": "Max Updated At",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "completed_at",
        "row_count",
        "distinct_record_ids",
        "logical_sha256",
        "record_id_set_sha256",
        "batch_count",
        "batch_id_set_sha256",
        "source_file_count",
        "source_file_set_sha256",
        "confirmation_status_counts",
        "min_updated_at",
        "max_updated_at"
      ],
      "title": "BloggerYdbScanEvidence",
      "type": "object"
    },
    "BloggerYdbSourceReadReceipt": {
      "additionalProperties": false,
      "description": "Detached, row-free evidence from an exact provider-side YDB preflight.",
      "properties": {
        "schema_version": {
          "const": "my-data-hub.region-talk-ydb-source-read-receipt.v1",
          "default": "my-data-hub.region-talk-ydb-source-read-receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "export_batch_id": {
          "format": "uuid",
          "title": "Export Batch Id",
          "type": "string"
        },
        "snapshot_at": {
          "format": "date-time",
          "title": "Snapshot At",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "database_id": {
          "const": "etnkibjidis0o6stn2cq",
          "default": "etnkibjidis0o6stn2cq",
          "title": "Database Id",
          "type": "string"
        },
        "database_path": {
          "const": "/ru-central1/b1ghfk15fpug7mn5439l/etnkibjidis0o6stn2cq",
          "default": "/ru-central1/b1ghfk15fpug7mn5439l/etnkibjidis0o6stn2cq",
          "title": "Database Path",
          "type": "string"
        },
        "table": {
          "const": "region_talk_external_blogger_evidence",
          "default": "region_talk_external_blogger_evidence",
          "title": "Table",
          "type": "string"
        },
        "schema_sha256": {
          "const": "a44855556115f90c0b6353cac0b8c5d1eaebf91485ca594c621cc73f91b2564f",
          "default": "a44855556115f90c0b6353cac0b8c5d1eaebf91485ca594c621cc73f91b2564f",
          "title": "Schema Sha256",
          "type": "string"
        },
        "query_sha256": {
          "const": "ef94cf114fea0e2f89418c5dacbc289e5c2d21f6935883c2b685ec4f64bd0e50",
          "default": "ef94cf114fea0e2f89418c5dacbc289e5c2d21f6935883c2b685ec4f64bd0e50",
          "title": "Query Sha256",
          "type": "string"
        },
        "reader_service_account_id": {
          "pattern": "^[a-z0-9]{20}$",
          "title": "Reader Service Account Id",
          "type": "string"
        },
        "database_roles": {
          "items": {
            "const": "ydb.viewer",
