{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.my-data-hub.local/run-manifest.v1.schema.json",
  "title": "my-data-hub run evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "workload",
    "code_revision",
    "canonical_revision",
    "files",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "my-data-hub-run-manifest.v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "workload": {
      "type": "string"
    },
    "code_revision": {
      "type": "string"
    },
    "canonical_revision": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
