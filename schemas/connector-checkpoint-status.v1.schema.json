{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-data-hub.invalid/schemas/connector-checkpoint-status.v1.schema.json",
  "title": "Connector checkpoint status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation_id", "state", "canonical_revision"],
  "properties": {
    "schema_version": {"const": "my-data-hub-connector-checkpoint-status.v1"},
    "request_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "state": {"enum": ["REQUESTED", "RUNNING", "DURABLE_COMPLETE", "FAILED", "FENCED", "ORPHANED"]},
    "canonical_revision": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "failure_code": {"type": "string", "minLength": 1, "maxLength": 200}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "DURABLE_COMPLETE"}}},
      "then": {"required": ["checkpoint_id", "manifest_sha256", "verified_at"]}
    },
    {
      "if": {"properties": {"state": {"enum": ["FAILED", "FENCED", "ORPHANED"]}}},
      "then": {"required": ["failure_code"]}
    }
  ]
}
