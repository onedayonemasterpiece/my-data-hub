{
  "$defs": {
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "kind": {
          "enum": [
            "object.create",
            "field.set",
            "set.add",
            "set.remove",
            "relation.add",
            "relation.remove",
            "state.transition",
            "object.tombstone",
            "event.append",
            "analysis.record",
            "pipeline.enqueue"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "preconditions": {
          "additionalProperties": true,
          "title": "Preconditions",
          "type": "object"
        },
        "target_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "target_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Type"
        }
      },
      "required": [
        "operation_id",
        "kind",
        "payload"
      ],
      "title": "Operation",
      "type": "object"
    }
  },
  "$id": "https://schemas.my-data-hub.local/changeset.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "base_revision": {
      "minimum": 0,
      "title": "Base Revision",
      "type": "integer"
    },
    "changeset_id": {
      "format": "uuid",
      "title": "Changeset Id",
      "type": "string"
    },
    "client_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Client Id",
      "type": "string"
    },
    "depends_on": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Depends On",
      "type": "array"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "idempotency_key": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema_version": {
      "const": "my-data-hub-changeset.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "changeset_id",
    "session_id",
    "client_id",
    "actor_id",
    "idempotency_key",
    "base_revision",
    "input_fingerprint",
    "operations"
  ],
  "title": "my-data-hub semantic changeset v1",
  "type": "object"
}
