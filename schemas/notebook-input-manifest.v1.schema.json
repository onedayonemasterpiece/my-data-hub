{
  "$defs": {
    "InputArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Size"
        },
        "locator": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "sha256"
      ],
      "title": "InputArtifactRef",
      "type": "object"
    },
    "NotebookLimits": {
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Items"
        },
        "max_output_bytes": {
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_runtime_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Runtime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_runtime_seconds",
        "max_output_bytes"
      ],
      "title": "NotebookLimits",
      "type": "object"
    },
    "NotebookModelSpec": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        },
        "encoder_contract": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoder Contract"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "task": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "version": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name",
        "version",
        "task"
      ],
      "title": "NotebookModelSpec",
      "type": "object"
    },
    "NotebookWorkItem": {
      "additionalProperties": false,
      "properties": {
        "input_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Fingerprint",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject Type",
          "type": "string"
        },
        "work_item_id": {
          "format": "uuid",
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "work_item_id",
        "subject_type",
        "subject_id",
        "input_fingerprint",
        "payload"
      ],
      "title": "NotebookWorkItem",
      "type": "object"
    }
  },
  "$id": "https://schemas.my-data-hub.local/notebook-input-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/InputArtifactRef"
      },
      "maxItems": 1000,
      "title": "Artifacts",
      "type": "array"
    },
    "canonical_revision": {
      "minimum": 0,
      "title": "Canonical Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/NotebookLimits"
    },
    "model": {
      "$ref": "#/$defs/NotebookModelSpec"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "my-data-hub-notebook-input.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "stage_contract_version": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Stage Contract Version",
      "type": "string"
    },
    "work_items": {
      "items": {
        "$ref": "#/$defs/NotebookWorkItem"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Work Items",
      "type": "array"
    },
    "workload": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Workload",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "workload",
    "stage",
    "stage_contract_version",
    "canonical_revision",
    "work_items",
    "model",
    "limits",
    "created_at"
  ],
  "title": "my-data-hub notebook input manifest v1",
  "type": "object"
}
