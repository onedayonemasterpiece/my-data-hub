{
  "$defs": {
    "assertion": {
      "additionalProperties": false,
      "properties": {
        "evidence_sha256": {
          "$ref": "#/$defs/sha"
        },
        "name": {
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        "outcome": {
          "const": "PASS"
        }
      },
      "required": [
        "name",
        "outcome",
        "evidence_sha256"
      ],
      "type": "object"
    },
    "blocker": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        "integration_dependency": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "integration_dependency"
      ],
      "type": "object"
    },
    "commit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "driver_capability_check": {
      "additionalProperties": false,
      "properties": {
        "detail_code": {
          "maxLength": 120,
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "maxLength": 120,
          "pattern": "^[a-z0-9_.-]+$",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "BLOCKED",
            "FAIL"
          ]
        }
      },
      "required": [
        "name",
        "outcome",
        "evidence_sha256",
        "detail_code"
      ],
      "type": "object"
    },
    "lifecycle": {
      "additionalProperties": false,
      "properties": {
        "after_identity": {
          "maxLength": 300,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "before_identity": {
          "maxLength": 300,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "completed_at": {
          "format": "date-time",
          "type": "string"
        },
        "duration_seconds": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "gate": {
          "enum": [
            "master_boot",
            "clean_rotation",
            "abrupt_master_termination",
            "control_plane_restart",
            "host_reboot",
            "soak"
          ]
        },
        "heartbeat_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "new_epoch": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "new_provider_run_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provider_run_ref"
            }
          ]
        },
        "old_epoch": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "old_provider_run_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provider_run_ref"
            }
          ]
        },
        "operation_id": {
          "maxLength": 300,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "read_query_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "recovery_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "event_id",
        "started_at",
        "completed_at",
        "old_provider_run_ref",
        "new_provider_run_ref",
        "old_epoch",
        "new_epoch",
        "operation_id",
        "before_identity",
        "after_identity",
        "duration_seconds",
        "heartbeat_count",
        "read_query_count",
        "checkpoint_count",
        "recovery_count"
      ],
      "type": "object"
    },
    "provider_ref": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "provider_run_ref": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[1-9][0-9]*$",
      "type": "string"
    },
    "sha": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.my-data-hub.local/provider/operational-kaggle-scenario-receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "assertions": {
            "minItems": 2
          },
          "blocker": {
            "type": "null"
          },
          "live_evidence": {
            "const": true
          },
          "real_run_identity": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "assertions": {
            "maxItems": 0
          },
          "blocker": {
            "$ref": "#/$defs/blocker"
          },
          "driver_mutations_started": {
            "const": 0
          },
          "live_evidence": {
            "const": false
          },
          "real_run_identity": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "FAIL"
          }
        }
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "live_evidence": {
            "const": false
          },
          "real_run_identity": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "assertions": {
      "items": {
        "$ref": "#/$defs/assertion"
      },
      "type": "array",
      "uniqueItems": true
    },
    "blocker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/blocker"
        }
      ]
    },
    "commit_sha": {
      "$ref": "#/$defs/commit"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "driver_capability_checks": {
      "items": {
        "$ref": "#/$defs/driver_capability_check"
      },
      "type": "array"
    },
    "driver_mutations_started": {
      "minimum": 0,
      "type": "integer"
    },
    "driver_observation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_events": {
      "items": {
        "$ref": "#/$defs/lifecycle"
      },
      "type": "array"
    },
    "live_evidence": {
      "type": "boolean"
    },
    "matrix_id": {
      "format": "uuid",
      "type": "string"
    },
    "operation_ids": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "ordinal": {
      "maximum": 24,
      "minimum": 1,
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "planned_task_run_id": {
      "format": "uuid",
      "type": "string"
    },
    "real_run_identity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "output_tree_sha256": {
              "$ref": "#/$defs/sha"
            },
            "provider_kernel_id": {
              "minimum": 1,
              "type": "integer"
            },
            "provider_ref": {
              "$ref": "#/$defs/provider_ref"
            },
            "provider_run_ref": {
              "$ref": "#/$defs/provider_run_ref"
            },
            "provider_status": {
              "const": "complete"
            },
            "result_sha256": {
              "$ref": "#/$defs/sha"
            },
            "source_sha256": {
              "$ref": "#/$defs/sha"
            },
            "source_version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "provider_ref",
            "provider_run_ref",
            "provider_kernel_id",
            "source_version",
            "source_sha256",
            "provider_status",
            "output_tree_sha256",
            "result_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "requirement_id": {
      "pattern": "^FM(0[1-9]|1[0-9]|2[0-4])$",
      "type": "string"
    },
    "scenario": {
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "my-data-hub-operational-kaggle-scenario-receipt.v1"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "matrix_id",
    "commit_sha",
    "ordinal",
    "requirement_id",
    "scenario",
    "outcome",
    "live_evidence",
    "planned_task_run_id",
    "real_run_identity",
    "assertions",
    "lifecycle_events",
    "operation_ids",
    "blocker",
    "started_at",
    "completed_at",
    "driver_mutations_started",
    "driver_capability_checks",
    "driver_observation_sha256"
  ],
  "title": "Operational Kaggle scenario receipt v1",
  "type": "object"
}
