{
  "$defs": {
    "RequirementEvidence": {
      "additionalProperties": false,
      "properties": {
        "assertion_evidence_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Assertion Evidence Sha256",
          "type": "object"
        },
        "operation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Operation Ids",
          "type": "array"
        },
        "requirement_id": {
          "enum": [
            "FM16",
            "FM17",
            "FM18",
            "FM19",
            "FM21"
          ],
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "assertion_evidence_sha256",
        "operation_ids"
      ],
      "title": "RequirementEvidence",
      "type": "object"
    }
  },
  "$id": "https://schemas.my-data-hub.invalid/provider/operational-data-evidence.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input to later live evidence execution. It is intentionally not PASS.",
  "properties": {
    "live_evidence": {
      "const": false,
      "default": false,
      "title": "Live Evidence",
      "type": "boolean"
    },
    "matrix_id": {
      "format": "uuid",
      "title": "Matrix Id",
      "type": "string"
    },
    "outcome": {
      "const": "EVIDENCE_READY",
      "default": "EVIDENCE_READY",
      "title": "Outcome",
      "type": "string"
    },
    "requirements": {
      "maxItems": 5,
      "minItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/RequirementEvidence"
        },
        {
          "$ref": "#/$defs/RequirementEvidence"
        },
        {
          "$ref": "#/$defs/RequirementEvidence"
        },
        {
          "$ref": "#/$defs/RequirementEvidence"
        },
        {
          "$ref": "#/$defs/RequirementEvidence"
        }
      ],
      "title": "Requirements",
      "type": "array"
    },
    "schema_version": {
      "const": "my-data-hub-operational-data-evidence.v1",
      "default": "my-data-hub-operational-data-evidence.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "matrix_id",
    "source_commit",
    "requirements"
  ],
  "title": "DataWorkloadEvidenceBundle",
  "type": "object"
}
