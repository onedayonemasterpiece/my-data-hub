{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.my-data-hub.local/provider/operational-kaggle-output.v1.schema.json",
  "title": "Exact operational Kaggle Notebook output v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "scenario", "task_run_id", "outcome", "assertions", "lifecycle_events", "operation_ids", "completed_at"],
  "properties": {
    "schema_version": {"const": "my-data-hub-operational-kaggle-output.v1"}, "matrix_id": {"type": "string", "format": "uuid"}, "scenario": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "task_run_id": {"type": "string", "format": "uuid"}, "outcome": {"enum": ["PASS", "FAIL"]},
    "assertions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "outcome", "evidence_sha256"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "outcome": {"enum": ["PASS", "FAIL"]}, "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "lifecycle_events": {"type": "array", "items": {"type": "object"}}, "operation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}, "completed_at": {"type": "string", "format": "date-time"}
  }
}
