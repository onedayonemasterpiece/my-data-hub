  "$id": "https://schemas.my-data-hub.local/provider/operational-kaggle-driver-result.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "READY",
              "PASS"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "mutations_started": {
            "minimum": 1
          },
