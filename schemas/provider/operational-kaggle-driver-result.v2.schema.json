            "type": "string"
          },
          "integration_dependency": {
            "type": "string"
          },
          "mutations_started": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "READY",
              "PASS"
            ]
          },
          "phase": {
            "const": "EXECUTE"
          }
        },
        "required": [
          "phase",
          "outcome"
        ]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "control_receipt": {
                "type": "null"
              },
              "scenario_output": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "scenario_output",
              "control_receipt"
