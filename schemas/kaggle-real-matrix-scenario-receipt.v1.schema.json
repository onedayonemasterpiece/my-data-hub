{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.my-data-hub.local/kaggle-real-matrix-scenario-receipt.v1.schema.json",
  "title": "Exact real Kaggle matrix scenario receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "matrix_id", "ordinal", "scenario", "category", "variant", "outcome", "live_evidence",
    "commit_sha", "task_id", "task_run_id", "provider_ref", "provider_run_ref",
    "provider_kernel_id", "source_version", "source_sha256", "provider_status", "privacy",
    "input_dataset", "manifest_sha256", "input_fingerprint", "result_sha256",
    "output_tree_sha256", "checkpoint_binding", "retry_policy", "resume", "fault_probe",
    "accounting", "cleanup", "started_at", "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "my-data-hub-real-kaggle-matrix-scenario.v1"},
    "matrix_id": {"type": "string", "format": "uuid"},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 100},
    "scenario": {"type": "string", "minLength": 1, "maxLength": 100},
    "category": {"enum": ["baseline", "identity", "retry", "resume", "idempotency", "fault", "checkpoint", "contract", "soak"]},
    "variant": {"type": "string", "minLength": 1, "maxLength": 100},
    "outcome": {"const": "PASS"},
    "live_evidence": {"const": true},
    "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "task_id": {"type": "string", "format": "uuid"},
    "task_run_id": {"type": "string", "format": "uuid"},
    "provider_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 300},
    "provider_run_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[1-9][0-9]*$", "maxLength": 320},
    "provider_kernel_id": {"type": "integer", "minimum": 1},
    "source_version": {"type": "integer", "minimum": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "provider_status": {"const": "complete"},
    "privacy": {"const": "private"},
    "input_dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_ref", "provider_version", "package_sha256"],
      "properties": {
        "provider_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "provider_version": {"type": "integer", "minimum": 1},
        "package_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "input_fingerprint": {"$ref": "#/$defs/sha256"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "output_tree_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_binding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["checkpoint_id", "manifest_sha256", "current_checkpoint_id"],
          "properties": {
            "checkpoint_id": {"type": "string", "format": "uuid"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "current_checkpoint_id": {"type": "string", "format": "uuid"}
          }
        }
      ]
    },
    "retry_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["interval_seconds", "timeout_seconds", "max_polls"],
      "properties": {
        "interval_seconds": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_polls": {"type": "integer", "minimum": 1}
      }
    },
    "resume": {
      "type": "object", "additionalProperties": false, "required": ["reused_exact_run"],
      "properties": {"reused_exact_run": {"type": "boolean"}}
    },
    "fault_probe": {
      "type": "object", "additionalProperties": true,
      "required": ["name", "outcome"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "outcome": {"enum": ["PASS", "NOT_REQUESTED"]}
      }
    },
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["input_items", "accounted_items", "successful_items", "failed_items"],
      "properties": {
        "input_items": {"const": 1}, "accounted_items": {"const": 1},
        "successful_items": {"const": 1}, "failed_items": {"const": 0}
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "detail_code"],
      "properties": {
        "outcome": {"const": "complete"},
        "detail_code": {"const": "task_created_resource_absent"}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
