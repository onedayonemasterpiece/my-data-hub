{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-datahub.kenigevents.ru/schemas/checkpoint-broker-publication.v1.schema.json",
  "title": "Checkpoint broker public publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "operation_id",
    "epoch",
    "manifest_sha256",
    "source_head_generation",
    "state",
    "exact_version_ref",
    "verifier_run_ref",
    "verifier_receipt_sha256",
    "failure_code",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "my-data-hub-checkpoint-broker-publication.v1"},
    "checkpoint_id": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "format": "uuid"},
    "epoch": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_head_generation": {"type": "integer", "minimum": 0},
    "state": {
      "enum": [
        "PREPARING",
        "UPLOADING",
        "READY_TO_FINALIZE",
        "FINALIZING",
        "DATASET_RESOLVED",
        "VERIFYING",
        "VERIFIED",
        "PROMOTED",
        "FAILED",
        "QUARANTINED"
      ]
    },
    "exact_version_ref": {"type": ["string", "null"], "maxLength": 512},
    "verifier_run_ref": {"type": ["string", "null"], "maxLength": 512},
    "verifier_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "failure_code": {"type": ["string", "null"], "maxLength": 120},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
